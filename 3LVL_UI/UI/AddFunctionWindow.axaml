<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="UI.AddFunctionWindow"
        Title="Калькулятор функций"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MinHeight="200">
        <StackPanel Margin="20">
        <ComboBox x:Name="typeComboBox" SelectedIndex="0" MaxDropDownHeight="100">
            <ComboBoxItem>Линейная</ComboBoxItem>
            <ComboBoxItem>Квадратичная</ComboBoxItem>
            <ComboBoxItem>Гипербола</ComboBoxItem>
        </ComboBox>
        <TextBox x:Name="paramA" Watermark="Параметр a"/>
        <TextBox x:Name="paramB" Watermark="Параметр b"/>
        <TextBox x:Name="paramC" Watermark="Параметр c" IsVisible="False"/>
        <Button Content="Добавить" Click="Add_Click"/>
        </StackPanel>
</Window>
