<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="UI.MainWindow"
        Title="Калькулятор функций"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MinHeight="200">
    <StackPanel Margin="20" Spacing="10">
        <Border Margin="5" CornerRadius="10" Background="LightBlue">
            <TextBlock Margin="5"
                       FontSize="24" 
                       HorizontalAlignment="Center"
                       Text="Калькулятор функций">
            </TextBlock>
        </Border>

        <Button Content="Показать все функции" Click="ShowAllFunctions_Click"/>
        <Button Content="Добавить функцию" Click="AddFunction_Click"/>
        <Button Content="Найти по индексу" Click="FindFunction_Click"/>
    </StackPanel>
</Window>
